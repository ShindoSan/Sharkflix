        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide">
    <g:evaluate var="jvar_endpoint" expression="gs.getProperty('x_1092529_sharkf_0.integration_endpoint')" />
    <g:evaluate var="jvar_retry_timeout" expression="gs.getProperty('x_1092529_sharkf_0.integration_retry_timeout')" />
    <g:evaluate var="jvar_plot" expression="gs.getProperty('x_1092529_sharkf_0.integration_plot')" />
    <g:evaluate var="jvar_active" expression="gs.getProperty('x_1092529_sharkf_0.integration_active')" />
    <g:evaluate var="jvar_retry_count" expression="gs.getProperty('x_1092529_sharkf_0.integration_retry_cont')" />
    <g:evaluate var="jvar_apikey" expression="gs.getProperty('x_1092529_sharkf_0.integration_apikey')" />

    <g:ui_form>
        <g:ui_panel title="SharkFin Integration Properties">
            <g:ui_input_field label="Integration Endpoint" name="endpoint" value="${jvar_endpoint}" />
            <g:ui_input_field label="Retry Timeout (in seconds)" name="retry_timeout" value="${jvar_retry_timeout}" />
            <g:ui_input_field label="Plot" name="plot" value="${jvar_plot}" />
            <g:ui_checkbox_field label="Integration Active" name="active" value="${jvar_active}" />
            <g:ui_input_field label="Retry Count" name="retry_count" value="${jvar_retry_count}" />
            <g:ui_input_field label="API Key" name="apikey" value="${jvar_apikey}" />
            
            <button type="submit" name="save_properties">Save</button>
        </g:ui_panel>
    </g:ui_form>
</j:jelly>]]></html>
        <name>System Properties</name>
        <processing_script><![CDATA[// Pega os valores enviados pelo formulário
var endpoint = request.getParameter('endpoint');
var retryTimeout = request.getParameter('retry_timeout');
var plot = request.getParameter('plot');
var active = request.getParameter('active');
var retryCount = request.getParameter('retry_count');
var apikey = request.getParameter('apikey');

// Atualiza as propriedades do sistema com os novos valores
gs.setProperty('x_1092529_sharkf_0.integration_endpoint', endpoint);
gs.setProperty('x_1092529_sharkf_0.integration_retry_timeout', retryTimeout);
gs.setProperty('x_1092529_sharkf_0.integration_plot', plot);
gs.setProperty('x_1092529_sharkf_0.integration_active', active);
gs.setProperty('x_1092529_sharkf_0.integration_retry_cont', retryCount);
gs.setProperty('x_1092529_sharkf_0.integration_apikey', apikey);

// Redireciona de volta para a mesma UI Page para mostrar os valores atualizados
response.sendRedirect('shark_fin_integration_properties.do');]]></processing_script>
